<Window x:Class="Wpf_todo_app.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf_todo_app"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel Margin="10">
        <TextBox Name="TaskInput" Width="250" Height="25" Margin="0,10,0,10" />
        <Button Content="Add task" Width="120" Height="30" Click="AddTaskClick" Margin="0,0,0,10" />
        <ListBox Name="TaskList" Height="200" />
        <Button Content="Delete" Width="120" Height="30" Click="RemoveTaskClick" Margin="0,10,0,0" />
        <Button Content="Done" Width="120" Height="30" Click="DoneClick" Margin="0,10,0,0" />
    </StackPanel>
        
    
</Window>
